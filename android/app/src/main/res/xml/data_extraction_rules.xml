<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de extração Android 12+ (API 31+): evita copiar dados pessoais/chaves locais para backups externos sem consentimento (RGPD). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
